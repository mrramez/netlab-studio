# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# google-java-format style (enforced by Spotless): 2-space indent, 100-column limit.
[*.java]
max_line_length = 100

[*.{cmd,bat}]
end_of_line = crlf

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
